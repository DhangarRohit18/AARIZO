# ==============================================================
# AARIZO CommunityOS - Environment Configuration Template
# ==============================================================

# --------------------------------------------------------------
# 1. FRONTEND PUBLIC CONFIGURATION (Vite Client-Side)
# (Safe to expose to browser. Prefixed with VITE_)
# --------------------------------------------------------------
VITE_FIREBASE_API_KEY=AIzaSy_your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=aarizo-society.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=aarizo-society
VITE_FIREBASE_STORAGE_BUCKET=aarizo-society.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef123456
VITE_USE_FIREBASE_EMULATOR=false

# Razorpay PUBLIC Key ID only (Safe for browser checkout modal)
VITE_RAZORPAY_KEY_ID=rzp_test_AARIZO_2026

# Backend API URL (optional fallback for REST endpoints)
VITE_BACKEND_URL=http://localhost:5000

# --------------------------------------------------------------
# 2. BACKEND SECRETS (Firebase Functions & Express Server ONLY)
# ⚠️ NEVER expose these in frontend code or commit to source control!
# --------------------------------------------------------------
# Razorpay Credentials (Secret Key for server signature verification & order creation)
RAZORPAY_KEY_ID=rzp_test_AARIZO_2026
RAZORPAY_KEY_SECRET=your_razorpay_secret_key_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# Firebase Admin SDK & Database
FIREBASE_PROJECT_ID=aarizo-society
PORT=5000
