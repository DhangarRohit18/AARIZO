rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // --- Identity Helpers --- //
    function isAuthenticated() { return request.auth != null; }
    function getRole() { return request.auth.token.role; }
    function getSocietyId() { return request.auth.token.societyId; }
    
    function isAdmin() { return getRole() == 'ADMIN'; }
    function isSecretary() { return getRole() == 'SECRETARY'; }
    
    // --- Society Scope --- //
    match /societies/{societyId} {
      
      // 1. Public Assets (e.g., Society Logo, public notices)
      match /public/{allPaths=**} {
        allow read: if isAuthenticated() && getSocietyId() == societyId;
        allow write: if isAuthenticated() && getSocietyId() == societyId && (isAdmin() || isSecretary());
      }
      
      // 2. Private User Documents (e.g., Profile Pictures, ID proofs)
      // Fix: A resident can ONLY write to their explicit UID folder, preventing overwrites.
      match /users/{userId}/{allPaths=**} {
        allow read: if isAuthenticated() && getSocietyId() == societyId && (request.auth.uid == userId || isAdmin() || isSecretary());
        allow write: if isAuthenticated() && getSocietyId() == societyId && (request.auth.uid == userId || isAdmin());
      }

      // 3. Compliance & AMC Documents (Highly Sensitive)
      // Fix: Only Admins/Secretaries can upload or modify. Residents can read ONLY if the DB says it's public (handled by UI presigned URLs ideally, but restricted here at root).
      match /compliance/{allPaths=**} {
        allow read: if isAuthenticated() && getSocietyId() == societyId; 
        allow write: if isAuthenticated() && getSocietyId() == societyId && (isAdmin() || isSecretary());
      }
      
      // 4. Invoices & Vendor Docs
      match /invoices/{allPaths=**} {
        allow read: if isAuthenticated() && getSocietyId() == societyId && (isAdmin() || isSecretary());
        allow write: if isAuthenticated() && getSocietyId() == societyId && (isAdmin() || isSecretary() || getRole() == 'VENDOR');
      }

      // 5. Vendor KYC, Contracts & Catalogs
      match /vendor/{allPaths=**} {
        allow read: if isAuthenticated() && getSocietyId() == societyId;
        allow write: if isAuthenticated() && getSocietyId() == societyId && (isAdmin() || isSecretary() || getRole() == 'VENDOR');
      }

      // 6. Resident Documents (Agreements, KYC, Receipts)
      match /resident/{allPaths=**} {
        allow read: if isAuthenticated() && getSocietyId() == societyId;
        allow write: if isAuthenticated() && getSocietyId() == societyId;
      }

      // 7. Maintenance & Ticket Photos/Invoices
      match /maintenance/{allPaths=**} {
        allow read: if isAuthenticated() && getSocietyId() == societyId;
        allow write: if isAuthenticated() && getSocietyId() == societyId;
      }

      // 8. Admin & Society Governance Docs
      match /admin/{allPaths=**} {
        allow read: if isAuthenticated() && getSocietyId() == societyId;
        allow write: if isAuthenticated() && getSocietyId() == societyId && (isAdmin() || isSecretary());
      }

      // 9. General Society Documents & Vault
      match /documents/{allPaths=**} {
        allow read: if isAuthenticated() && getSocietyId() == societyId;
        allow write: if isAuthenticated() && getSocietyId() == societyId;
      }

      match /general/{allPaths=**} {
        allow read: if isAuthenticated() && getSocietyId() == societyId;
        allow write: if isAuthenticated() && getSocietyId() == societyId;
      }
    }
    
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
