rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Authentication & Custom Claims Helpers --- //
    function isAuthenticated() { 
      return request.auth != null; 
    }
    
    // STRICT CUSTOM CLAIMS: We trust only the verified Firebase token claims.
    function getRole() { 
      return request.auth.token.role; 
    }
    
    function getSocietyId() { 
      return request.auth.token.societyId; 
    }
    
    function hasValidClaims() {
      return isAuthenticated() && 
             request.auth.token.role != null && 
             request.auth.token.societyId != null;
    }
    
    function isAdmin() { return hasValidClaims() && getRole() == 'admin'; }
    function isSecretary() { return hasValidClaims() && getRole() == 'secretary'; }
    function isCommittee() { return hasValidClaims() && getRole() == 'committee'; }
    function isFacilityManager() { return hasValidClaims() && getRole() == 'facility_manager'; }
    function isGuard() { return hasValidClaims() && getRole() == 'guard'; }
    function isResident() { return hasValidClaims() && getRole() == 'resident'; }
    function isVendor() { return hasValidClaims() && getRole() == 'vendor'; }
    
    function isSocietyMatch(docSocietyId) { 
      return hasValidClaims() && (isAdmin() || getSocietyId() == docSocietyId); 
    }
    
    function isOwner(userId) { 
      return isAuthenticated() && request.auth.uid == userId; 
    }

    // --- Users Collection --- //
    match /users/{userId} {
      // 1. Resident reading own profile → allowed
      // 2. Cross-society reading → denied (only admin or matching society leadership can read other profiles)
      allow read: if isAuthenticated() && (
        isOwner(userId) || 
        (isSocietyMatch(resource.data.societyId) && (isAdmin() || isSecretary() || isFacilityManager() || isGuard()))
      );
      
      // User creation: Only admin or matching secretary, or user creating initial profile without role/society tampering
      allow create: if isAuthenticated() && (
        isAdmin() || 
        (isSecretary() && isSocietyMatch(request.resource.data.societyId)) ||
        (isOwner(userId) && !request.resource.data.keys().hasAny(['role', 'societyId', 'permissions']))
      );

      // User update:
      // 3. Changing own role → denied (cannot touch role)
      // 4. Changing societyId → denied (cannot touch societyId)
      allow update: if isAuthenticated() && (
        isAdmin() || 
        (isSecretary() && isSocietyMatch(resource.data.societyId) && request.resource.data.role != 'admin') ||
        (isOwner(userId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'societyId', 'permissions', 'id', 'uid']))
      );

      allow delete: if isAdmin();
    }

    // --- Societies Collection --- //
    match /societies/{societyDocId} {
      allow read: if isAuthenticated() && (isAdmin() || isSocietyMatch(societyDocId));
      allow create, update, delete: if isAdmin();
    }

    // --- Towers Collection --- //
    match /towers/{towerId} {
      allow read: if isAuthenticated() && isSocietyMatch(resource.data.societyId);
      allow create, update, delete: if isAuthenticated() && isSocietyMatch(request.resource.data.societyId) && (isAdmin() || isSecretary());
    }

    // --- Flats Collection --- //
    match /flats/{flatId} {
      allow read: if isAuthenticated() && isSocietyMatch(resource.data.societyId);
      allow create, update, delete: if isAuthenticated() && isSocietyMatch(request.resource.data.societyId) && (isAdmin() || isSecretary());
    }

    // --- Residents Collection --- //
    match /residents/{residentId} {
      allow read: if isAuthenticated() && isSocietyMatch(resource.data.societyId);
      allow create, update, delete: if isAuthenticated() && isSocietyMatch(request.resource.data.societyId) && (isAdmin() || isSecretary());
    }

    // --- Family Members Collection --- //
    match /familyMembers/{memberId} {
      allow read: if isAuthenticated() && isSocietyMatch(resource.data.societyId);
      allow create, update, delete: if isAuthenticated() && isSocietyMatch(request.resource.data.societyId) && (
        isAdmin() || isSecretary() || (isResident() && isOwner(request.resource.data.residentId))
      );
    }

    // --- Vehicles Collection --- //
    match /vehicles/{vehicleId} {
      allow read: if isAuthenticated() && isSocietyMatch(resource.data.societyId);
      allow create, update, delete: if isAuthenticated() && isSocietyMatch(request.resource.data.societyId) && (
        isAdmin() || isSecretary() || isGuard() || (isResident() && isOwner(request.resource.data.residentId))
      );
    }

    // --- Staff Collection --- //
    match /staff/{staffId} {
      allow read: if isAuthenticated() && isSocietyMatch(resource.data.societyId);
      allow create, update, delete: if isAuthenticated() && isSocietyMatch(request.resource.data.societyId) && (
        isAdmin() || isSecretary() || isFacilityManager()
      );
    }

    // --- Domestic Workers Collection --- //
    match /domesticWorkers/{workerId} {
      allow read: if isAuthenticated() && isSocietyMatch(resource.data.societyId);
      allow create, update, delete: if isAuthenticated() && isSocietyMatch(request.resource.data.societyId) && (
        isAdmin() || isSecretary() || isGuard()
      );
    }

    // --- Vendors Collection --- //
    match /vendors/{vendorId} {
      allow read: if isAuthenticated() && isSocietyMatch(resource.data.societyId);
      allow create, update, delete: if isAuthenticated() && isSocietyMatch(request.resource.data.societyId) && (
        isAdmin() || isSecretary() || isFacilityManager()
      );
    }

    // --- Amenities Collection --- //
    match /amenities/{amenityId} {
      allow read: if isAuthenticated() && isSocietyMatch(resource.data.societyId);
      allow create, update, delete: if isAuthenticated() && isSocietyMatch(request.resource.data.societyId) && (
        isAdmin() || isSecretary() || isFacilityManager()
      );
    }

    // --- Amenity Bookings Collection --- //
    match /amenityBookings/{bookingId} {
      allow read: if isAuthenticated() && isSocietyMatch(resource.data.societyId) && (
        isAdmin() || isSecretary() || isFacilityManager() || (isResident() && isOwner(resource.data.residentId))
      );
      allow create: if isAuthenticated() && isSocietyMatch(request.resource.data.societyId) && (
        isAdmin() || isSecretary() || (isResident() && isOwner(request.resource.data.residentId))
      );
      allow update: if isAuthenticated() && isSocietyMatch(resource.data.societyId) && (
        isAdmin() || isSecretary() || isFacilityManager() ||
        (isResident() && isOwner(resource.data.residentId) && request.resource.data.status == 'CANCELLED')
      );
      allow delete: if isAdmin();
    }

    // --- Visitor Passes Collection --- //
    match /visitorPasses/{passId} {
      allow read: if isAuthenticated() && isSocietyMatch(resource.data.societyId) && (
        isAdmin() || isSecretary() || isFacilityManager() || isGuard() || (isResident() && isOwner(resource.data.residentId))
      );
      allow create: if isAuthenticated() && isSocietyMatch(request.resource.data.societyId) && (
        isAdmin() || isSecretary() || isGuard() || (isResident() && isOwner(request.resource.data.residentId))
      );
      allow update: if isAuthenticated() && isSocietyMatch(resource.data.societyId) && (
        isAdmin() || isSecretary() || isGuard() ||
        (isResident() && isOwner(resource.data.residentId) && request.resource.data.status == 'CANCELLED')
      );
      allow delete: if isAdmin();
    }

    // --- Guest Rooms & Reservations --- //
    match /guestRooms/{roomId} {
      allow read: if isAuthenticated() && isSocietyMatch(resource.data.societyId);
      allow create, update, delete: if isAuthenticated() && isSocietyMatch(request.resource.data.societyId) && (
        isAdmin() || isSecretary()
      );
    }

    match /guestReservations/{reservationId} {
      allow read: if isAuthenticated() && isSocietyMatch(resource.data.societyId) && (
        isAdmin() || isSecretary() || (isResident() && isOwner(resource.data.residentId))
      );
      allow create: if isAuthenticated() && isSocietyMatch(request.resource.data.societyId) && (
        isAdmin() || isSecretary() || (isResident() && isOwner(request.resource.data.residentId))
      );
      allow update: if isAuthenticated() && isSocietyMatch(resource.data.societyId) && (
        isAdmin() || isSecretary() ||
        (isResident() && isOwner(resource.data.residentId) && request.resource.data.status == 'CANCELLED')
      );
      allow delete: if isAdmin();
    }

    // --- Billing Cycles & Invoices --- //
    match /billingCycles/{cycleId} {
      allow read: if isAuthenticated() && isSocietyMatch(resource.data.societyId);
      allow create, update, delete: if isAuthenticated() && isSocietyMatch(request.resource.data.societyId) && (
        isAdmin() || isSecretary()
      );
    }

    match /billingInvoices/{invoiceId} {
      allow read: if isAuthenticated() && isSocietyMatch(resource.data.societyId) && (
        isAdmin() || isSecretary() || isCommittee() || (isResident() && isOwner(resource.data.residentId))
      );
      allow create: if isAuthenticated() && isSocietyMatch(request.resource.data.societyId) && (
        isAdmin() || isSecretary()
      );
      allow update: if isAuthenticated() && isSocietyMatch(resource.data.societyId) && (
        isAdmin() || isSecretary() ||
        (isResident() && isOwner(resource.data.residentId) &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'paidAmount', 'paymentMode', 'paidAt', 'updatedAt']))
      );
      allow delete: if isAdmin();
    }

    match /billingTransactions/{txId} {
      allow read: if isAuthenticated() && isSocietyMatch(resource.data.societyId) && (
        isAdmin() || isSecretary() || isCommittee() || (isResident() && isOwner(resource.data.residentId))
      );
      allow create: if isAuthenticated() && isSocietyMatch(request.resource.data.societyId) && (
        isAdmin() || isSecretary() || (isResident() && isOwner(request.resource.data.residentId))
      );
      allow update, delete: if isAdmin() || isSecretary();
    }

    // --- Maintenance Tickets --- //
    match /maintenanceTickets/{ticketId} {
      allow read: if isAuthenticated() && isSocietyMatch(resource.data.societyId) && (
        isAdmin() || isSecretary() || isFacilityManager() || (isResident() && isOwner(resource.data.residentId))
      );
      allow create: if isAuthenticated() && isSocietyMatch(request.resource.data.societyId) && (
        isAdmin() || isSecretary() || (isResident() && isOwner(request.resource.data.residentId))
      );
      allow update: if isAuthenticated() && isSocietyMatch(resource.data.societyId) && (
        isAdmin() || isSecretary() || isFacilityManager() ||
        (isResident() && isOwner(resource.data.residentId) &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'feedbackNotes', 'updatedAt']) &&
         request.resource.data.status in ['CLOSED', 'REOPENED'])
      );
      allow delete: if isAdmin();
    }

    // --- Housekeeping Tasks & Logs --- //
    match /housekeepingTasks/{taskId} {
      allow read: if isAuthenticated() && isSocietyMatch(resource.data.societyId);
      allow create, update, delete: if isAuthenticated() && isSocietyMatch(request.resource.data.societyId) && (
        isAdmin() || isSecretary() || isFacilityManager()
      );
    }

    // --- Parking Slots & Requests --- //
    match /parkingSlots/{slotId} {
      allow read: if isAuthenticated() && isSocietyMatch(resource.data.societyId);
      allow create, update, delete: if isAuthenticated() && isSocietyMatch(request.resource.data.societyId) && (
        isAdmin() || isSecretary() || isGuard()
      );
    }

    match /parkingRequests/{requestId} {
      allow read: if isAuthenticated() && isSocietyMatch(resource.data.societyId) && (
        isAdmin() || isSecretary() || (isResident() && isOwner(resource.data.residentId))
      );
      allow create: if isAuthenticated() && isSocietyMatch(request.resource.data.societyId) && (
        isAdmin() || isSecretary() || (isResident() && isOwner(request.resource.data.residentId))
      );
      allow update: if isAuthenticated() && isSocietyMatch(resource.data.societyId) && (
        isAdmin() || isSecretary() ||
        (isResident() && isOwner(resource.data.residentId) && request.resource.data.status == 'CANCELLED')
      );
      allow delete: if isAdmin();
    }

    // --- Child Safety --- //
    match /children/{childId} {
      allow read: if isAuthenticated() && isSocietyMatch(resource.data.societyId) && (
        isAdmin() || isSecretary() || isGuard() || (isResident() && isOwner(resource.data.residentId))
      );
      allow create, update: if isAuthenticated() && isSocietyMatch(request.resource.data.societyId) && (
        isAdmin() || isSecretary() || (isResident() && isOwner(request.resource.data.residentId))
      );
      allow delete: if isAdmin() || (isResident() && isOwner(resource.data.residentId));
    }

    // --- Emergency / Safety Command --- //
    match /emergencyIncidents/{incidentId} {
      allow read: if isAuthenticated() && isSocietyMatch(resource.data.societyId);
      allow create: if isAuthenticated() && isSocietyMatch(request.resource.data.societyId);
      allow update: if isAuthenticated() && isSocietyMatch(resource.data.societyId) && (
        isAdmin() || isSecretary() || isGuard() || isFacilityManager()
      );
      allow delete: if isAdmin();
    }

    // --- Complaints Collection --- //
    match /complaints/{complaintId} {
      // 7. Cross-society complaint read → denied
      allow read: if isAuthenticated() && isSocietyMatch(resource.data.societyId) && (
        isAdmin() || isSecretary() || isCommittee() || isFacilityManager() ||
        (isResident() && isOwner(resource.data.residentId)) ||
        (isVendor() && request.auth.uid == resource.data.assignedTo)
      );

      allow create: if isAuthenticated() && isSocietyMatch(request.resource.data.societyId) && (
        (isResident() && isOwner(request.resource.data.residentId)) ||
        isAdmin() || isSecretary()
      );

      // Residents cannot tamper with SLA, priority, or administrative assignment
      allow update: if isAuthenticated() && isSocietyMatch(resource.data.societyId) && (
        isAdmin() || isSecretary() || isFacilityManager() ||
        (isResident() && isOwner(resource.data.residentId) && 
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'feedbackNotes', 'updatedAt']) &&
         request.resource.data.status in ['CLOSED', 'REOPENED']) ||
        (isVendor() && request.auth.uid == resource.data.assignedTo && 
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'resolvedAt', 'updatedAt']))
      );

      allow delete: if isAdmin();
    }

    // --- Parcels Collection --- //
    match /parcels/{parcelId} {
      // 8. Cross-society parcel read → denied
      allow read: if isAuthenticated() && isSocietyMatch(resource.data.societyId) && (
        isAdmin() || isSecretary() || isFacilityManager() || isGuard() ||
        (isResident() && isOwner(resource.data.residentId))
      );

      allow create: if isAuthenticated() && isSocietyMatch(request.resource.data.societyId) && (
        isAdmin() || isSecretary() || isGuard()
      );

      allow update: if isAuthenticated() && isSocietyMatch(resource.data.societyId) && (
        isAdmin() || isSecretary() || isGuard() ||
        (isResident() && isOwner(resource.data.residentId) && 
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'pickedUpAt', 'updatedAt']))
      );

      allow delete: if isAdmin();
    }

    // --- Attendance / Domestic Help --- //
    match /attendance/{attendanceId} {
      allow read: if isAuthenticated() && isSocietyMatch(resource.data.societyId) && (
        isAdmin() || isSecretary() || isFacilityManager() || isGuard() ||
        isResident()
      );

      allow write: if isAuthenticated() && isSocietyMatch(request.resource.data.societyId) && (
        isAdmin() || isSecretary() || isGuard()
      );
    }

    // --- Moves & Renovations --- //
    match /moveRequests/{moveId} {
      allow read: if isAuthenticated() && isSocietyMatch(resource.data.societyId) && (
        isAdmin() || isSecretary() || isFacilityManager() || isGuard() ||
        (isResident() && isOwner(resource.data.residentId))
      );

      allow create: if isAuthenticated() && isSocietyMatch(request.resource.data.societyId) && 
                    isResident() && isOwner(request.resource.data.residentId);

      allow update: if isAuthenticated() && isSocietyMatch(resource.data.societyId) && (
        isAdmin() || isSecretary() ||
        (isResident() && isOwner(resource.data.residentId) && request.resource.data.status == 'CANCELLED')
      );
    }

    match /renovations/{renovationId} {
      allow read: if isAuthenticated() && isSocietyMatch(resource.data.societyId) && (
        isAdmin() || isSecretary() || isFacilityManager() || isGuard() ||
        (isResident() && isOwner(resource.data.residentId))
      );

      allow create: if isAuthenticated() && isSocietyMatch(request.resource.data.societyId) && 
                    isResident() && isOwner(request.resource.data.residentId);

      allow update: if isAuthenticated() && isSocietyMatch(resource.data.societyId) && (
        isAdmin() || isSecretary() ||
        (isResident() && isOwner(resource.data.residentId) && request.resource.data.status == 'CANCELLED')
      );
    }

    // --- AMC Contracts & Compliance --- //
    // 5. Guard performing secretary-only operation → denied
    // 6. Secretary authorized society operation → allowed
    match /amcContracts/{amcId} {
      allow read: if isAuthenticated() && isSocietyMatch(resource.data.societyId) && (
        isAdmin() || isSecretary() || isCommittee() || isFacilityManager() ||
        (isResident() && resource.data.isPublicToResidents == true)
      );

      allow write: if isAuthenticated() && isSocietyMatch(request.resource.data.societyId) && (
        isAdmin() || isSecretary()
      );
    }

    // --- Notifications Collection --- //
    match /notifications/{notifId} {
      allow read: if isAuthenticated() && isSocietyMatch(resource.data.societyId) && (
        isAdmin() || isSecretary() || (isResident() && request.auth.uid == resource.data.recipientId)
      );
      allow create: if isAuthenticated() && isSocietyMatch(request.resource.data.societyId) && (
        isAdmin() || isSecretary() || isGuard() || isFacilityManager()
      );
      allow update: if isAuthenticated() && isSocietyMatch(resource.data.societyId) && (
        isAdmin() || isSecretary() ||
        (request.auth.uid == resource.data.recipientId &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'isRead', 'readAt']))
      );
      allow delete: if isAdmin();
    }

    // --- Audit Logs Collection (Append-only by authorized actors) --- //
    match /auditLogs/{logId} {
      allow read: if isAuthenticated() && isSocietyMatch(resource.data.societyId) && (
        isAdmin() || isSecretary() || isCommittee()
      );
      allow create: if isAuthenticated() && isSocietyMatch(request.resource.data.societyId);
      allow update, delete: if false; // Append-only immutable audit trail
    }

    // --- QR Tokens --- //
    match /qrTokens/{tokenId} {
      allow read: if isAuthenticated() && isSocietyMatch(resource.data.societyId) && (
        isAdmin() || isSecretary() || isGuard()
      );
      // No client can forge QR tokens
      allow write: if false;
    }

    // 9. Unauthenticated Firestore access → denied
    // 10. Missing custom claims → denied for protected operations
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
