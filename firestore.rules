rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Authentication & Identity Helpers --- //
    function isAuthenticated() { return request.auth != null; }
    
    // STRICT CUSTOM CLAIMS: We never trust the document, only the unforgeable JWT token.
    function getRole() { return request.auth.token.role; }
    function getSocietyId() { return request.auth.token.societyId; }
    
    function isAdmin() { return getRole() == 'ADMIN'; }
    function isSecretary() { return getRole() == 'SECRETARY'; }
    function isGuard() { return getRole() == 'GUARD'; }
    function isResident() { return getRole() == 'RESIDENT'; }
    function isVendor() { return getRole() == 'VENDOR'; }
    
    function isSocietyMatch(docSocietyId) { return getSocietyId() == docSocietyId; }
    function isOwner(residentId) { return request.auth.uid == residentId; }

    // --- Users Collection (Fixes Role Escalation) --- //
    match /users/{userId} {
      // Residents can read their own. Admins/Secretaries can read all in society. Guards view minimal.
      allow read: if isAuthenticated() && (
        request.auth.uid == userId || 
        (isSocietyMatch(resource.data.societyId) && (isAdmin() || isSecretary() || isGuard()))
      );
      
      // Fix: Only Admins can create new users, or users can create their own profile but cannot inject 'role'.
      allow create: if isAuthenticated() && (
        isAdmin() || 
        (request.auth.uid == userId && !request.resource.data.keys().hasAny(['role', 'permissions']))
      );

      // Fix: Role Escalation Attack vector closed. Residents can only modify specific safe fields.
      allow update: if isAuthenticated() && (
        isAdmin() || 
        (request.auth.uid == userId && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'societyId', 'permissions', 'id']))
      );
    }

    // --- Complaints (Fixes Isolation & SLA Manipulation) --- //
    match /complaints/{complaintId} {
      allow read: if isAuthenticated() && isSocietyMatch(resource.data.societyId) && (
        isAdmin() || isSecretary() || 
        (isResident() && isOwner(resource.data.residentId)) ||
        (isVendor() && request.auth.uid == resource.data.assignedTo)
      );

      allow create: if isAuthenticated() && isSocietyMatch(request.resource.data.societyId) && 
                    isResident() && isOwner(request.resource.data.residentId);

      // Fix: Residents cannot manipulate SLA or escalation statuses.
      allow update: if isAuthenticated() && isSocietyMatch(resource.data.societyId) && (
        isAdmin() || isSecretary() || 
        (isResident() && isOwner(resource.data.residentId) && 
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'feedback', 'updatedAt']) &&
         request.resource.data.status in ['CLOSED', 'REOPENED']) ||
        (isVendor() && request.auth.uid == resource.data.assignedTo && 
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'resolvedAt', 'updatedAt']))
      );
    }

    // --- Generic Module Scoping (Moves, Renovations, Parcels) --- //
    match /{collection}/{documentId} {
      allow read: if isAuthenticated() && isSocietyMatch(resource.data.societyId) && 
                     (collection in ['moveRequests', 'renovations', 'parcels', 'attendance']) && (
                       isAdmin() || isSecretary() || isGuard() || 
                       (isResident() && (isOwner(resource.data.residentId) || isOwner(resource.data.recipientId)))
                     );
                     
      allow create: if isAuthenticated() && isSocietyMatch(request.resource.data.societyId) && 
                       (collection in ['moveRequests', 'renovations']) && 
                       isResident() && isOwner(request.resource.data.residentId);
                       
      allow update: if isAuthenticated() && isSocietyMatch(resource.data.societyId) && 
                       (collection in ['moveRequests', 'renovations']) && (
                         isAdmin() || isSecretary() || isGuard() || 
                         (isResident() && isOwner(resource.data.residentId) && request.resource.data.status == 'CANCELLED')
                       );
    }

    // --- AMC & Compliance --- //
    match /amcContracts/{amcId} {
      // Only Admins/Secretaries can manage AMCs. Residents can view IF public.
      allow read: if isAuthenticated() && isSocietyMatch(resource.data.societyId) && (
        isAdmin() || isSecretary() || 
        (isResident() && resource.data.isPublicToResidents == true)
      );
      
      allow write: if isAuthenticated() && isSocietyMatch(resource.data.societyId) && (isAdmin() || isSecretary());
    }

    // --- QR Tokens --- //
    match /qrTokens/{tokenId} {
      // Extremely strict. No client can CREATE a QR Token directly. Must be done via Cloud Functions or Server.
      allow read: if isAuthenticated() && isSocietyMatch(resource.data.societyId) && (isAdmin() || isSecretary() || isGuard());
      allow write: if false; // Block completely. Must use backend.
    }

    // Global Fallback Deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
